{
  "name": "volatility-profiler",
  "private": true,
  "description": "Volatility profiling for LLM prompts: which parts are shared across actors, which change between calls, and which lines change",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "api": "npm --workspace @volatility/api run start --",
    "relay": "npm --workspace @volatility/relay run start --",
    "skyrimnet:relay": "npm --workspace @volatility/skyrimnet run relay --",
    "skyrimnet:import": "npm --workspace @volatility/skyrimnet run import --",
    "viewer": "npm --workspace @volatility/viewer run dev",
    "test": "npm --workspaces --if-present test",
    "typecheck": "npm --workspaces run typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^6.0.1",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0"
  },
  "engines": {
    "node": ">=24"
  }
}
